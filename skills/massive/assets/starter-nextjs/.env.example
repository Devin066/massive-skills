# Copy to .env.local and fill in. Never commit .env.local.
# Key: https://massive.com/dashboard/keys  (sign up: https://massive.com/dashboard/signup)
# Server-only. Do NOT rename to NEXT_PUBLIC_* - that ships the key to every browser.
MASSIVE_API_KEY=

# Live stream feed for the stocks WebSocket relay. Run `npm run probe` to pick:
#   off       - no WebSocket (Stocks Basic / free plan); dashboard polls REST
#   delayed   - wss://delayed.massive.com  (Stocks Starter / Developer, 15-min delayed)
#   realtime  - wss://socket.massive.com   (Stocks Advanced)
MASSIVE_WS_FEED=off

# Comma-separated watchlist shown on the dashboard.
MASSIVE_WATCHLIST=AAPL,MSFT,NVDA,AMZN,GOOGL,META,TSLA,SPY
